@page "/todo"
@rendermode InteractiveServer

<MudText Typo="Typo.h5" Class="mb-4">
    Todo (@todos.Count(todo => !todo.IsDone))
</MudText>

<MudList T="TodoModel" DisablePadding="true">
    @foreach (var todo in todos)
    {
        <MudListItem T="TodoModel" DisableGutters="true">

            <MudCheckBox @bind-Checked="todo.IsDone" />

            <MudTextField @bind-Value="todo.Title"
                          Variant="Variant.Text"
                          Immediate="true"
                          Class="ml-2 flex-grow-1" />

            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           OnClick="@(() => RemoveTodo(todo))" />
        </MudListItem>
    }
</MudList>

<MudDivider Class="my-4" />

<MudTextField @bind-Value="newTodo"
              Label="New Todo"
              Variant="Variant.Outlined"
              FullWidth="true" />

<MudButton Class="mt-3"
           Color="Color.Primary"
           Variant="Variant.Filled"
           OnClick="AddTodo">
    Add Todo
</MudButton>

@code {
    private List<TodoModel> todos = new();
    private string newTodo = string.Empty;

    void AddTodo()
    {
        if (!string.IsNullOrWhiteSpace(newTodo))
        {
            todos.Add(new TodoModel { Title = newTodo });
            newTodo = string.Empty;
        }
    }

    void RemoveTodo(TodoModel todo)
    {
        todos.Remove(todo);
    }

    public class TodoModel
    {
        public string Title { get; set; } = string.Empty;
        public bool IsDone { get; set; }
    }
}

